APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
# Dedicated durable pepper for v4.4.1 API-key digests; rotating it invalidates issued keys.
API_KEY_PEPPER=replace-with-an-independent-random-secret
# v4.4.2 public decision quotas (Redis is required in production)
V44_ORGANIZATION_QUOTA=1000
V44_CREDENTIAL_QUOTA=100
V44_QUOTA_WINDOW_SECONDS=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_DISPLAY_NAME=John Simo
# AUTH_DISABLED=1  # development only; ignored as a recommendation for production

# Database (SQLite is used when omitted)
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/nfl_analytics

# Phase 10 data platform
DATABASE_URL=postgresql+psycopg://nfl:change-me@localhost:5432/nfl_analytics
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
REDIS_URL=redis://localhost:6379/0
ENABLE_SCHEDULER=false

# P2.1 warehouse retention. Disabled until an administrator reviews the
# read-only preview and intentionally enables the daily pruning job.
ENABLE_WAREHOUSE_RETENTION=false
WAREHOUSE_RETENTION_INTERVAL_MINUTES=1440
WAREHOUSE_RAW_RETENTION_DAYS=180
WAREHOUSE_RAW_VERSIONS_PER_ENTITY=5
WAREHOUSE_SYNC_RUN_RETENTION_DAYS=180
WAREHOUSE_SYNC_RUNS_PER_SOURCE=25
WAREHOUSE_RESOLVED_QUALITY_RETENTION_DAYS=90
WAREHOUSE_RETENTION_BATCH_SIZE=5000

# External data integration. A provider family and an individual dataset must
# both be enabled; cadence values are minutes.
EXTERNAL_DATA_TIMEOUT=60
EXTERNAL_DATA_SEASON=2026
EXTERNAL_DATA_WEEK=
ENABLE_EXTERNAL_SYNC=false
ENABLE_EXTERNAL_ROSTERS_SYNC=false
ENABLE_EXTERNAL_INJURIES_SYNC=false
ENABLE_EXTERNAL_DEPTH_CHARTS_SYNC=false
ENABLE_EXTERNAL_PBP_SYNC=false
ENABLE_EXTERNAL_SNAP_COUNTS_SYNC=false
ENABLE_EXTERNAL_PLAYER_STATS_SYNC=false
EXTERNAL_ROSTERS_INTERVAL_MINUTES=360
EXTERNAL_INJURIES_INTERVAL_MINUTES=120
EXTERNAL_DEPTH_CHARTS_INTERVAL_MINUTES=1440
EXTERNAL_PBP_INTERVAL_MINUTES=360
EXTERNAL_SNAP_COUNTS_INTERVAL_MINUTES=360
EXTERNAL_PLAYER_STATS_INTERVAL_MINUTES=360

# Credentialed external providers (all optional; integrations fail closed)
ENABLE_COMMERCIAL_SYNC=false
ENABLE_COMMERCIAL_WEATHER_SYNC=false
ENABLE_COMMERCIAL_ODDS_SYNC=false
ENABLE_COMMERCIAL_LIVE_GAMES_SYNC=false
ENABLE_COMMERCIAL_COACHES_SYNC=false
ENABLE_COMMERCIAL_TRANSACTIONS_SYNC=false
COMMERCIAL_WEATHER_INTERVAL_MINUTES=30
COMMERCIAL_ODDS_INTERVAL_MINUTES=10
COMMERCIAL_LIVE_GAMES_INTERVAL_MINUTES=2
COMMERCIAL_COACHES_INTERVAL_MINUTES=1440
COMMERCIAL_TRANSACTIONS_INTERVAL_MINUTES=60
OPENWEATHER_API_KEY=
# Shared by both odds paths: the props/lines layer (odds_api.py) and the
# commercial sync (commercial_integrations.py). Key presence alone cannot spend
# credits; the canonical provider and explicit runtime gate are also required.
ODDS_API_KEY=
ENABLE_ODDS_API=false
# commercial_integrations.py only
ODDS_API_URL=https://api.the-odds-api.com/v4/sports/americanfootball_nfl/odds
ODDS_REGIONS=us
ODDS_MARKETS=h2h,spreads,totals
# odds_api.py reads its own region and caching knobs
ODDS_REGION=us
# One frozen snapshot per day; lower only if you mean to spend more credits.
NFL_ODDS_GAME_TTL_SEC=21600
NFL_ODDS_PROPS_TTL_SEC=21600
# Alternate prop lines multiply per-event credit cost; off by default.
NFL_ODDS_INCLUDE_ALT=0
SPORTSDATAIO_API_KEY=
SPORTSDATAIO_BASE_URL=https://api.sportsdata.io/v3/nfl
# Override these templates when your SportsDataIO subscription exposes different routes.
SPORTSDATAIO_COACHES_PATH=scores/json/TeamSeasonStats/{season}
SPORTSDATAIO_TRANSACTIONS_PATH=scores/json/Transactions/{season}

# Version 2.1 integration control plane
ENABLED_PROVIDERS=nflverse,nws,the-odds-api
WEATHER_PROVIDER=nws
# NWS requires an identifying user agent; no API key is required.
NWS_USER_AGENT=nfl-analytics-hub/2.1 contact@example.com
# SportsDataIO live score endpoint template (adjust for your subscription/feed).
SPORTSDATAIO_SCORES_PATH=scores/json/Scores/{season}
